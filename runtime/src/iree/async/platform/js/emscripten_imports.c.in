#include <emscripten.h>

#include "iree/async/platform/js/token_table.h"

EM_JS(void, iree_async_emscripten_register_poll,
      (uintptr_t proactor, uintptr_t callback, int pointer_bits), {
  const host = Module['ireeAsyncHost'];
  host.pollCallbacks ||= new Map();
  const pointer = pointer_bits === 64 ? BigInt(proactor) : Number(proactor);
  host.pollCallbacks.set(proactor, () => Module['wasmTable'].get(pointer_bits === 64 ? BigInt(callback) : Number(callback))(pointer));
  host.context.exports ||= {};
  host.context.exports.proactor_drain = () => {
    for (const poll of host.pollCallbacks.values()) poll();
  };
});

EM_JS(void, iree_async_emscripten_unregister_poll, (uintptr_t proactor), {
  Module['ireeAsyncHost'].pollCallbacks?.delete(proactor);
});

EM_JS(void, iree_async_emscripten_initialize, (void), {
  if (Module['ireeAsyncHost']?.attachWorker) return;

  @IREE_WASM_IMPORTS@

  // Share one host per Emscripten instance, including dynamically loaded libraries.
  const context = Module['ireeAsyncHost']?.context || {
    memory: wasmMemory,
    inline: true,
    clockNowNs: () => BigInt(Math.round(performance.now() * 1e6)),
  };
  Module['ireeAsyncHost'] = {
    context,
    imports: Module['ireeAsyncHost']?.imports || createWasmImports(context).iree_proactor,
    attachWorker(ringBuffer, cancelControl, postMessage, onComplete) {
      const inline = this.imports;
      const imports = createWasmImports({
        ...context, inline: false, ringBuffer, ringCapacity: 256,
        cancelControl, postMessage,
      }).iree_proactor;
      this.imports = {...imports, ring_drain(pointer, capacity) {
        const inlineCount = inline.ring_drain(pointer, capacity);
        if (inlineCount) return inlineCount;
        const count = imports.ring_drain(pointer, capacity);
        const offset = typeof pointer === 'bigint' ? Number(pointer) : pointer >>> 0;
        const entries = new Int32Array(wasmMemory.buffer, offset, count * 2);
        for (let i = 0; i < count; ++i) onComplete(entries[i * 2]);
        return count;
      }};
    },
  };
});

EM_JS(uint32_t, iree_async_emscripten_ring_drain,
      (iree_async_js_completion_entry_t* buffer, uint32_t capacity), {
  return Module['ireeAsyncHost'].imports.ring_drain(buffer, capacity);
});
EM_JS(uint32_t, iree_async_emscripten_poll_wait, (int64_t deadline_ns), {
  return Module['ireeAsyncHost'].imports.poll_wait(deadline_ns);
});
EM_JS(void, iree_async_emscripten_timer_start,
      (uint32_t token, int64_t deadline_ns), {
  Module['ireeAsyncHost'].imports.timer_start(token, deadline_ns);
});
EM_JS(uint32_t, iree_async_emscripten_timer_cancel, (uint32_t token), {
  return Module['ireeAsyncHost'].imports.timer_cancel(token);
});
EM_JS(void, iree_async_emscripten_wake, (void), {
  Module['ireeAsyncHost'].imports.wake();
});
EM_JS(void, iree_async_emscripten_schedule_drain, (void), {
  Module['ireeAsyncHost'].imports.schedule_drain();
});

__attribute__((constructor)) static void iree_async_emscripten_initialize_host(
    void) {
  iree_async_emscripten_initialize();
}

uint32_t iree_async_js_import_ring_drain(
    iree_async_js_completion_entry_t* buffer, uint32_t capacity) {
  return iree_async_emscripten_ring_drain(buffer, capacity);
}
uint32_t iree_async_js_import_poll_wait(int64_t deadline_ns) {
  return iree_async_emscripten_poll_wait(deadline_ns);
}
void iree_async_js_import_timer_start(uint32_t token, int64_t deadline_ns) {
  iree_async_emscripten_timer_start(token, deadline_ns);
}
uint32_t iree_async_js_import_timer_cancel(uint32_t token) {
  return iree_async_emscripten_timer_cancel(token);
}
void iree_async_js_import_wake(void) { iree_async_emscripten_wake(); }
void iree_async_js_import_schedule_drain(void) {
  iree_async_emscripten_schedule_drain();
}
